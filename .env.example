# Copy this file to .env and fill in at least GROQ_API_KEY.
# Everything else has a sensible default (see backend/config.py) and can be
# left as-is.

# --- Required ---------------------------------------------------------
# Get a key at https://console.groq.com
GROQ_API_KEY=


# --- LLM ----------------------------------------------------------------
# Groq deprecated llama-3.1-8b-instant on the free/developer tier (shut off
# Aug 2026); openai/gpt-oss-20b is Groq's own recommended replacement for it
# and is confirmed working. Full current list: console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only needed if you switch EMBEDDING_MODEL to a gated/private HF model.
HF_TOKEN=

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
RELOAD=true
# Comma-separated list of origins allowed to call the API. Defaults to the
# app serving itself, so you usually don't need to touch this.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Chunking & retrieval ------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
MAX_DISTANCE_THRESHOLD=2.0
MAX_CHUNKS_PER_DOCUMENT=2
MIN_MEANINGFUL_CHARS=20
MAX_HISTORY_TURNS=5

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- Storage paths (defaults are fine for local use) ------------------
# DOCUMENT_STORE_DIR=./document_store
# CHROMA_DB_DIR=./chroma_db
# SQLITE_DB_PATH=./docquery.db
# FRONTEND_DIR=./frontend

# --- Contact form (optional -- the form will report itself as
#     unconfigured and fail cleanly if these are left blank) ---------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RECEIVER_EMAIL=
